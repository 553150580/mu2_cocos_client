
CCEffect %{
  techniques:
  - name: light-effect
    passes:
    - vert: vs:vert
      frag: fs:frag
      blendState:
        targets:
          - blend: true
            blendSrc: src_alpha
            blendDst: one_minus_src_alpha
            blendSrcAlpha: src_alpha
            blendDstAlpha: one_minus_src_alpha
        depthStencilState:
            depthTest: false
            depthWrite: false
            # depthFunc: less
      properties:
        # params: { value: [16.0, 0.3, 1.2, 2.0], editor: { 
        #   type: vector, 
        #   labels: ["波纹密度", "波纹强度", "基础亮度", "高亮区域亮度"] 
        # }}
        rippleDensity: { value: 16.0, editor: { type: slider, range: [1, 200] } } #波纹密度
        rippleIntensity: { value: 0.3, editor: { type: slider, range: [0, 2] } }  # 波纹强度
        baseBrightness: { value: 1.2, editor: { type: slider, range: [0.5, 5.0] } }  # 基础亮度
        highlightBrightness: { value: 2.0, editor: { type: slider, range: [1, 5] } }  # 高亮区域亮度
        rippleColor: { value: [1.0, 0.9, 0.5, 0.5], editor: { type: color } }  # 新增：水波颜色+速度（第4个表示速度）
}%

//顶点着色器保持不变
CCProgram vs %{
  precision mediump float;
  #include <cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;   
  out vec2 uv;

  #if USE_LOCAL
    in vec4 a_color; 
    out vec4 v_color; 
  #endif

  vec4 vert() {
    vec4 pos = vec4(a_position, 1);

    #if USE_LOCAL
      pos = cc_matWorld * pos; 
      v_color = a_color;
    #endif

    pos = cc_matViewProj * pos;
    uv = a_texCoord;
    
    return pos;
  }
}%
CCProgram fs %{
  precision highp float;
  #include <cc-global>
  #include <sprite-texture>

  in vec2 uv;

  // 使用vec4打包参数，避免UBO对齐问题
  // uniform Constant {
  //   vec4 params; // x:密度 y:强度 z:亮度 w:高亮
  // };
  uniform RippleUBO {
    float rippleDensity;
    float rippleIntensity;
    float baseBrightness;
    float highlightBrightness;
    vec4 rippleColor;  // 新增：水波颜色+速度（第4个表示速度）
  };

  // #pragma define iterationCount 3

  vec4 frag () {
    //对 uv 进行标准化（假设 uv 范围在 0-1）
    vec2 fixedUv = clamp(uv, 0.0, 1.0);
    vec4 baseColor = texture(cc_spriteTexture, fixedUv);
    if (baseColor.a < 0.1) {
      discard;
    }
    float density = rippleDensity;
    if (density < 10.0) {
        density=10.0;
    }
    float time = cc_time.x * rippleColor.a;

    // 水波纹计算
    vec2 p = mod(fixedUv * density, density) - 250.0;
    vec2 i = p;

    float accum = 1.0;
    float intensity = 0.0045;

    for (int n = 0; n < 2; n++) {
        float t = time * (1.0 - (3.5 / float(n+1)));
        i = p + vec2(
          cos(t - i.x) + sin(t + i.y),
          sin(t - i.y) + cos(1.5*t + i.x)
        );
        float len = length(vec2(
          p.x / (cos(i.x + t) / intensity),
          p.y / (cos(i.y + t) / intensity)
        ));
        if(len<0.0001) len=0.0001;
        accum += 1.0 / len;
    }
    accum /= 5.0;
    accum = 1.17 - pow(accum, 1.4);
    
    vec3 rippleColor1 = rippleColor.rgb * pow(abs(accum), 20.0);
    rippleColor1 = clamp(rippleColor1, 0.0, baseColor.a);

    // 基础亮度调节
    vec3 baseAdjusted = baseColor.rgb * baseBrightness;
    
    // 波纹区域使用更高的亮度
    vec3 rippleAdjusted = rippleColor1 * accum * highlightBrightness * rippleIntensity;
    
    // 混合基础颜色和波纹高亮
    vec3 finalRGB = baseAdjusted + rippleAdjusted;
    
    // 确保颜色值在合理范围内
    finalRGB = clamp(finalRGB, 0.0, 3.0);
    
    return vec4(finalRGB, baseColor.a);
  }
}%